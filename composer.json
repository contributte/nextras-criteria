{
  "name": "contributte/nextras-criteria",
  "description": "Criteria pattern for Nextras ORM inspired by Doctrine",
  "keywords": ["nextras", "orm", "criteria", "filter", "query", "nette"],
  "type": "library",
  "license": "BSD-3-Clause",
  "homepage": "https://github.com/contributte/nextras-criteria",
  "authors": [
    {
      "name": "Contributte",
      "homepage": "https://contributte.org"
    }
  ],
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "nextras/orm": "^4.0 || ^5.0",
    "phpunit/phpunit": "^10.0 || ^11.0",
    "phpstan/phpstan": "^1.10",
    "phpstan/phpstan-strict-rules": "^1.5"
  },
  "suggest": {
    "nextras/orm": "To use criteria with Nextras ORM collections"
  },
  "autoload": {
    "psr-4": {
      "Contributte\\Criteria\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Contributte\\Criteria\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "phpstan": "phpstan analyse"
  },
  "extra": {
    "branch-alias": {
      "dev-master": "1.0.x-dev"
    }
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
