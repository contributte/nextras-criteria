{
	"name": "contributte/nextras-criteria",
	"description": "Criteria pattern for Nextras ORM inspired by Doctrine",
	"keywords": ["nextras", "orm", "criteria", "filter", "query", "nette"],
	"type": "library",
	"license": "BSD-3-Clause",
	"homepage": "https://github.com/contributte/nextras-criteria",
	"authors": [
		{
			"name": "Contributte",
			"homepage": "https://contributte.org"
		}
	],
	"require": {
		"php": ">=8.2"
	},
	"require-dev": {
		"contributte/phpstan": "~0.2.0",
		"contributte/qa": "~0.4.0",
		"contributte/tester": "~0.3.0",
		"nextras/orm": "^4.0.0 || ^5.0.0"
	},
	"conflict": {
		"nextras/orm": "<4.0 || >=6.0"
	},
	"suggest": {
		"nextras/orm": "To apply criteria to Nextras ORM collections (^4.0 || ^5.0)"
	},
	"autoload": {
		"psr-4": {
			"Contributte\\Criteria\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Tests\\": "tests/"
		}
	},
	"extra": {
		"branch-alias": {
			"dev-master": "0.1.x-dev"
		}
	},
	"config": {
		"sort-packages": true,
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	},
	"minimum-stability": "dev",
	"prefer-stable": true
}
